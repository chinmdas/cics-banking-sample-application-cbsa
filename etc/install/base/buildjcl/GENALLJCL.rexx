/* REXX */
/*********************************************************************/
/* GENALLJCL - Generate JCL to create ADATA for all copybooks       */
/*                                                                   */
/* This REXX script reads all members from IN0050.CBSA.DSECT and    */
/* generates JCL with EXEC statements for each member.               */
/*                                                                   */
/* Usage: TSO EXEC 'your.rexx.lib(GENALLJCL)'                       */
/*                                                                   */
/* Output: JCL written to IN0050.CBSA.JCL(GENALLJCL)                */
/*********************************************************************/

/* Configuration */
COPYBOOK_PDS = 'IN0050.CBSA.DSECT'
OUTPUT_JCL   = 'IN0050.CBSA.JCL(GENALLJCL)'
ADATA_PDS    = 'IN0050.CBSA.ADATA'

SAY 'Reading members from' COPYBOOK_PDS
SAY ''

/* Get list of members from the PDS */
x = OUTTRAP('members.')
"LISTDS '"COPYBOOK_PDS"' MEMBERS"
rc = RC
x = OUTTRAP('OFF')

IF rc <> 0 THEN DO
  SAY 'ERROR: Could not list members of' COPYBOOK_PDS
  SAY 'Return code:' rc
  EXIT 8
END

/* Count members (skip header lines) */
member_count = 0
DO i = 7 TO members.0
  member = STRIP(members.i)
  IF member <> '' & member <> '--MEMBERS--' THEN
    member_count = member_count + 1
END

SAY 'Found' member_count 'copybook members'
SAY ''
SAY 'Generating JCL...'
SAY ''

/* Allocate output dataset */
"ALLOC F(OUTJCL) DA('"OUTPUT_JCL"') SHR REUSE"
IF RC <> 0 THEN DO
  SAY 'ERROR: Could not allocate' OUTPUT_JCL
  EXIT 8
END

/* Write JCL header */
QUEUE '//GENALL   JOB (FB3),''GENERATE ALL ADATA'',CLASS=A,MSGCLASS=H,'
QUEUE '//         NOTIFY=&SYSUID,MSGLEVEL=(1,1)'
QUEUE '//*'
QUEUE '//* Auto-generated JCL to create ADATA for all copybooks'
QUEUE '//* Generated by GENALLJCL.rexx on' DATE() 'at' TIME()
QUEUE '//*'
QUEUE '//* Source PDS:' COPYBOOK_PDS
QUEUE '//* Output PDS:' ADATA_PDS
QUEUE '//* Total members:' member_count
QUEUE '//*'
QUEUE '//* ============================================================'
QUEUE '//* PROC Definition'
QUEUE '//* ============================================================'
QUEUE '//*'
QUEUE '//GENPROC PROC MEMBER=DUMMY'
QUEUE '//GENADATA EXEC PGM=IGYCRCTL,REGION=0M,'
QUEUE '//            PARM=(NODYNAM,LIB,RENT,LIST,MAP,XREF,'
QUEUE "//   'APOST,ADATA,NOCOMPILE(W)')"
QUEUE '//*'
QUEUE '//STEPLIB  DD DSN=PP.COBOL390.V640.SIGYCOMP,DISP=SHR'
QUEUE '//         DD DISP=SHR,DSN=ANTZ.CICS.TS.DEV.INTEGRAT.SDFHLOAD'
QUEUE '//SYSLIB   DD DISP=SHR,DSN=IN0050.CBSA.DSECT'
QUEUE '//         DD DISP=SHR,DSN=PP.ADLE370.ZOS301.SCEESAMP'
QUEUE '//         DD DISP=SHR,DSN=ANTZ.CICS.TS.DEV.INTEGRAT.SDFHCOB'
QUEUE '//SYSPRINT DD SYSOUT=*'
QUEUE '//SYSADATA DD DSN='ADATA_PDS'(&MEMBER),DISP=SHR'
QUEUE '//SYSUT1   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT2   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT3   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT4   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT5   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT6   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT7   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT8   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT9   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT10  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT11  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT12  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT13  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT14  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSUT15  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSMDECK DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))'
QUEUE '//SYSIN    DD *'
QUEUE '       PROCESS ADATA'
QUEUE '       IDENTIFICATION DIVISION.'
QUEUE '       PROGRAM-ID. &MEMBER.CPY.'
QUEUE '       DATA DIVISION.'
QUEUE '       WORKING-STORAGE SECTION.'
QUEUE '       COPY &MEMBER..'
QUEUE '       PROCEDURE DIVISION.'
QUEUE '           STOP RUN.'
QUEUE '/*'
QUEUE '//        PEND'
QUEUE '//*'
QUEUE '//* ============================================================'
QUEUE '//* Execute PROC for each copybook member'
QUEUE '//* ============================================================'
QUEUE '//*'

/* Generate EXEC statement for each member */
step_num = 0
DO i = 7 TO members.0
  member = STRIP(members.i)
  IF member <> '' & member <> '--MEMBERS--' THEN DO
    step_num = step_num + 1
    stepname = 'STEP'RIGHT(step_num,4,'0')
    QUEUE '//'stepname 'EXEC PROC=GENPROC,MEMBER='member
  END
END

/* Write JCL footer */
QUEUE '//*'
QUEUE '//* ============================================================'
QUEUE '//* End of generated JCL'
QUEUE '//* ============================================================'

/* Write queued lines to output */
"EXECIO" QUEUED() "DISKW OUTJCL (FINIS"
IF RC <> 0 THEN DO
  SAY 'ERROR: Could not write to' OUTPUT_JCL
  "FREE F(OUTJCL)"
  EXIT 8
END

"FREE F(OUTJCL)"

SAY 'JCL successfully generated:'
SAY '  Output:' OUTPUT_JCL
SAY '  Steps:' step_num
SAY ''
SAY 'To submit: TSO SUBMIT' "'"OUTPUT_JCL"'"
SAY ''

EXIT 0