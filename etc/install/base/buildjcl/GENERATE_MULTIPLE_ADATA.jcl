//GENADATA JOB (FB3),'GENERATE ADATA',CLASS=A,MSGCLASS=H,
//         NOTIFY=&SYSUID,MSGLEVEL=(1,1)
//*
//* Copyright IBM Corp. 2023
//*
//* JCL to compile multiple COBOL copybooks and generate ADATA files
//* for IBM Record Generator for Java
//*
//* This JCL demonstrates two approaches:
//* 1. Multiple steps (one per copybook) - Recommended for clarity
//* 2. Single step with multiple COPY statements - More efficient
//*
//* ================================================================
//* APPROACH 1: SEPARATE STEPS (RECOMMENDED)
//* ================================================================
//* Each copybook gets its own step with dedicated ADATA output
//* Advantages: Clear separation, easy to debug, parallel execution
//* ================================================================
//*
//CUSTOMER EXEC PGM=IGYCRCTL,REGION=0M,
//            PARM=(NODYNAM,LIB,RENT,LIST,MAP,XREF,
//   'APOST,ADATA,NOCOMPILE(W)')
//STEPLIB  DD DSN=PP.COBOL390.V640.SIGYCOMP,DISP=SHR
//         DD DISP=SHR,DSN=ANTZ.CICS.TS.DEV.INTEGRAT.SDFHLOAD
//SYSLIB   DD DISP=SHR,DSN=IN0050.CBSA.DSECT
//         DD DISP=SHR,DSN=PP.ADLE370.ZOS301.SCEESAMP
//         DD DISP=SHR,DSN=ANTZ.CICS.TS.DEV.INTEGRAT.SDFHCOB
//SYSPRINT DD SYSOUT=*
//SYSADATA DD DSN=IN0050.CBSA.ADATA(CUSTOMER),DISP=SHR
//SYSUT1   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT2   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT3   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT4   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT5   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT6   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT7   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT8   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT9   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT10  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT11  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT12  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT13  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT14  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT15  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSMDECK DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSIN    DD *
       PROCESS ADATA
       IDENTIFICATION DIVISION.
       PROGRAM-ID. CUSTCOPY.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY CUSTOMER.
       PROCEDURE DIVISION.
           STOP RUN.
/*
//*
//ACCOUNT EXEC PGM=IGYCRCTL,REGION=0M,
//            PARM=(NODYNAM,LIB,RENT,LIST,MAP,XREF,
//   'APOST,ADATA,NOCOMPILE(W)')
//STEPLIB  DD DSN=PP.COBOL390.V640.SIGYCOMP,DISP=SHR
//         DD DISP=SHR,DSN=ANTZ.CICS.TS.DEV.INTEGRAT.SDFHLOAD
//SYSLIB   DD DISP=SHR,DSN=IN0050.CBSA.DSECT
//         DD DISP=SHR,DSN=PP.ADLE370.ZOS301.SCEESAMP
//         DD DISP=SHR,DSN=ANTZ.CICS.TS.DEV.INTEGRAT.SDFHCOB
//SYSPRINT DD SYSOUT=*
//SYSADATA DD DSN=IN0050.CBSA.ADATA(ACCOUNT),DISP=SHR
//SYSUT1   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT2   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT3   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT4   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT5   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT6   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT7   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT8   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT9   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT10  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT11  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT12  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT13  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT14  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT15  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSMDECK DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSIN    DD *
       PROCESS ADATA
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ACCTCOPY.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY ACCOUNT.
       PROCEDURE DIVISION.
           STOP RUN.
/*
//*
//PROCTRAN EXEC PGM=IGYCRCTL,REGION=0M,
//            PARM=(NODYNAM,LIB,RENT,LIST,MAP,XREF,
//   'APOST,ADATA,NOCOMPILE(W)')
//STEPLIB  DD DSN=PP.COBOL390.V640.SIGYCOMP,DISP=SHR
//         DD DISP=SHR,DSN=ANTZ.CICS.TS.DEV.INTEGRAT.SDFHLOAD
//SYSLIB   DD DISP=SHR,DSN=IN0050.CBSA.DSECT
//         DD DISP=SHR,DSN=PP.ADLE370.ZOS301.SCEESAMP
//         DD DISP=SHR,DSN=ANTZ.CICS.TS.DEV.INTEGRAT.SDFHCOB
//SYSPRINT DD SYSOUT=*
//SYSADATA DD DSN=IN0050.CBSA.ADATA(PROCTRAN),DISP=SHR
//SYSUT1   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT2   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT3   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT4   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT5   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT6   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT7   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT8   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT9   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT10  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT11  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT12  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT13  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT14  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSUT15  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSMDECK DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//SYSIN    DD *
       PROCESS ADATA
       IDENTIFICATION DIVISION.
       PROGRAM-ID. PROCCOPY.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY PROCTRAN.
       PROCEDURE DIVISION.
           STOP RUN.
/*
//*
//* ================================================================
//* APPROACH 2: SINGLE STEP WITH MULTIPLE COPIES (ALTERNATIVE)
//* ================================================================
//* All copybooks in one compilation - generates single ADATA file
//* Advantages: Faster execution, single ADATA file
//* Disadvantages: All copybooks in one ADATA, harder to debug
//* ================================================================
//*
//*MULTI   EXEC PGM=IGYCRCTL,REGION=0M,
//*            PARM=(NODYNAM,LIB,RENT,LIST,MAP,XREF,
//*  'APOST,ADATA,NOCOMPILE(W)')
//*TEPLIB  DD DSN=PP.COBOL390.V640.SIGYCOMP,DISP=SHR
//*        DD DISP=SHR,DSN=ANTZ.CICS.TS.DEV.INTEGRAT.SDFHLOAD
//*YSLIB   DD DISP=SHR,DSN=IN0050.CBSA.DSECT
//*        DD DISP=SHR,DSN=PP.ADLE370.ZOS301.SCEESAMP
//*        DD DISP=SHR,DSN=ANTZ.CICS.TS.DEV.INTEGRAT.SDFHCOB
//*YSPRINT DD SYSOUT=*
//*YSADATA DD DSN=IN0050.CBSA.ADATA(MULTIPLE),DISP=SHR
//*YSUT1   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT2   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT3   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT4   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT5   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT6   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT7   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT8   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT9   DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT10  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT11  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT12  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT13  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT14  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSUT15  DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSMDECK DD UNIT=SYSALLDA,SPACE=(TRK,(350,100))
//*YSIN    DD *
//*     PROCESS ADATA
//*     IDENTIFICATION DIVISION.
//*     PROGRAM-ID. MULTICOPY.
//*     DATA DIVISION.
//*     WORKING-STORAGE SECTION.
//*     COPY CUSTOMER.
//*     COPY ACCOUNT.
//*     COPY PROCTRAN.
//*     PROCEDURE DIVISION.
//*         STOP RUN.
//**
//*
//* ================================================================
//* NOTES:
//* ================================================================
//* 1. Approach 1 (separate steps) is RECOMMENDED because:
//*    - Each copybook gets its own ADATA file
//*    - Easier to debug individual copybook issues
//*    - Can run steps in parallel if needed
//*    - Clear separation of concerns
//*
//* 2. Approach 2 (single step) can be used when:
//*    - You need all copybooks in one ADATA file
//*    - The copybooks are related and should be processed together
//*    - You want faster execution (single compilation)
//*
//* 3. IBM Record Generator can process:
//*    - Individual ADATA files (one per copybook)
//*    - Single ADATA file with multiple copybooks
//*    - You specify which record to extract using symbol= parameter
//*
//* 4. For automation, consider creating a PROC:
//*    - Define a procedure with symbolic parameters
//*    - Pass copybook name as parameter
//*    - Reuse the same JCL structure for all copybooks
//*